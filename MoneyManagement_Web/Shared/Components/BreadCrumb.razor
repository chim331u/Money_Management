@if (breadCrumbData != null)
{
    <RadzenRow AlignItems="AlignItems.Start" JustifyContent="JustifyContent.Left" Gap="0px">
        <RadzenBreadCrumb>
            @foreach (var item in breadCrumbData)
            {
                <RadzenBreadCrumbItem Path="@item.breadCrumbPath" Text="@item.breadCrumbText" />
            }
        </RadzenBreadCrumb>

    </RadzenRow>
}



@code {

