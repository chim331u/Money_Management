    public IUtilityServices _utilityService { get; set; }

    [Parameter]
    public string? path { get; set; }

    List<BreadCrumbData>? breadCrumbData;

    protected override async Task OnInitializedAsync()
    {
        UpdateBreadCrumb(path);
    }

