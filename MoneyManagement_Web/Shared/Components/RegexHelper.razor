<div class="rz-p-12">
    <RadzenText TextStyle="TextStyle.Subtitle2">\s* = Matches any space, tab or newline character.</RadzenText>
    <RadzenText TextStyle="TextStyle.Subtitle2">\d = Matches any decimal digit. Equivalent to [0-9].</RadzenText>
    <RadzenText TextStyle="TextStyle.Subtitle2">\w = Matches any letter, digit or underscore. Equivalent to [a-zA-Z0-9_]</RadzenText>
    <RadzenText TextStyle="TextStyle.Subtitle2">\n = Matches a newline character</RadzenText>
    <RadzenText TextStyle="TextStyle.Subtitle2">. = Matches any character other than newline (or including line terminators with the /s flag)</RadzenText>

    <RadzenText TextStyle="TextStyle.Subtitle2">\s*([\d,.]+)\s*€ = Numbers that ends with € symbol [i.e. 460,30 €]</RadzenText>
    <RadzenText TextStyle="TextStyle.Subtitle2">\s*([\w,.]+)\s* = Word contains numbers and letters [i.e. abc123]</RadzenText>
    <RadzenText TextStyle="TextStyle.Subtitle2">\s+([\d,.]+\s+[\w,.]+\s+[\d,.]+)\s* = Date [i.e. 1 Dicembre 2023]</RadzenText>
    <RadzenText TextStyle="TextStyle.Subtitle2">\s+([\d,.]+/+[\d,.]+/+[\d,.]+)\s* = Date [i.e. 01/12/2023]</RadzenText>

    <RadzenLink Path="https://regex101.com/" Text="https://regex101.com/" />
</div>

