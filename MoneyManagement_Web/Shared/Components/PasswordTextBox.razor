<RadzenRow JustifyContent="JustifyContent.Center">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Gap="0.5rem">
        <RadzenText>@cleanPsw</RadzenText>
        <RadzenButton Click="CopyToClipboard" Icon="content_copy" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small"></RadzenButton>
    </RadzenStack>
</RadzenRow>

@code {

    [Inject] public IUtilityServices _service { get; set; }

    [Parameter] public string? cleanPsw { get; set; }

    private void CopyToClipboard()
    {
        if (string.IsNullOrEmpty(cleanPsw))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Copy to ClipBoard",
                Detail = $"Password must be valued",
                Duration = 1000
            });
        }
        else
        {
            _service.CopyToClipboard(cleanPsw);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Copy to ClipBoard",
                Detail = $"Password Copied",
                Duration = 1000
            });
        }
    }

}
