@page "/"
<MM_WEB.Shared.Components.BreadCrumb path="/"></MM_WEB.Shared.Components.BreadCrumb>
@if (_accessService.IsAuthorized)
{
    @if (dashboard != null)
    {
        <RadzenStack Gap="1rem" Style="position: relative">
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                    <RadzenCard Style="position: relative;">
                        <RadzenStack Gap="0" Orientation="Orientation.Vertical">
                            <RadzenText TextStyle="TextStyle.H5">Spent (@_utilityService.FormatAsDate(lastSpent.SpentDate))</RadzenText>
                            <RadzenStack Orientation="Orientation.Horizontal">
                                <RadzenIcon Icon=@FormatDiffIcon(lastSpent.SpentAmount-prevSpent.SpentAmount) IconStyle=@FormatDiffIconStyle(lastSpent.SpentAmount-prevSpent.SpentAmount)></RadzenIcon>
                                    <RadzenText TextStyle="TextStyle.H6" Class="rz-color-danger">was @_utilityService.FormatAsEUR(prevSpent.SpentAmount) (@_utilityService.FormatAsEUR((lastSpent.SpentAmount - prevSpent.SpentAmount)))</RadzenText>
                            </RadzenStack>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.H4" Class="rz-color-danger" Style="position: absolute; right: 1.5rem; top: 1rem;">
                            @_utilityService.FormatAsEUR(lastSpent.SpentAmount)
                        </RadzenText>
                        <RadzenChart Style="width: 100%; height: 120px; margin-bottom: -30px;">
                            <RadzenColumnSeries Data=@spentChart ValueProperty="SpentAmount" CategoryProperty="SpentDate" Title="Spent" Fill="var(--rz-danger)">
                                @*                                 <RadzenSeriesMedianLine Visible="true" Stroke="var(--rz-light-dark)" LineType="LineType.Dashed" /> *@
                            </RadzenColumnSeries>
                            <RadzenValueAxis Visible="false" Formatter="@_utilityService.FormatAsEUR" />
                            <RadzenCategoryAxis Visible="false" Formatter="@_utilityService.FormatAsDate" />
                            <RadzenColumnOptions Margin="10" />
                            <RadzenLegend Visible="false" />
                        </RadzenChart>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                    <RadzenCard Style="position: relative;">
                        <RadzenStack Gap="0" Orientation="Orientation.Vertical">
                            <RadzenText TextStyle="TextStyle.H5">
                                Salary (@_utilityService.FormatAsDate(lastSalary.RefDate))
                            </RadzenText>
                            <RadzenStack Orientation="Orientation.Horizontal">
                                <RadzenIcon Icon=@FormatDiffIcon(lastSalary.SalaryAmountEur-prevSalary.SalaryAmountEur) IconStyle=@FormatDiffIconStyle(lastSalary.SalaryAmountEur-prevSalary.SalaryAmountEur)></RadzenIcon>
                                <RadzenText TextStyle="TextStyle.H6" Class="rz-color-info">was @_utilityService.FormatAsEUR(prevSalary.SalaryAmountEur) (@_utilityService.FormatAsEUR((lastSalary.SalaryAmountEur - prevSalary.SalaryAmountEur)))</RadzenText>
                           
                        </RadzenStack>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.H4" Class="rz-color-info" Style="position: absolute; right: 1.5rem; top: 1rem;">@_utilityService.FormatAsEUR(lastSalary.SalaryAmountEur)</RadzenText>
                        <RadzenChart Style="width: 100%; height: 120px; margin-bottom: -30px;">
                            <RadzenColumnSeries Data=@salaryChart ValueProperty="SalaryAmountEur" CategoryProperty="RefDate"
                                                Title="Salary" Fill="var(--rz-info)">
                                @*                                 <RadzenSeriesMedianLine Visible="true" Stroke="var(--rz-light-dark)" LineType="LineType.Dashed" /> *@
                            </RadzenColumnSeries>
                            <RadzenValueAxis Visible="false" Formatter="@_utilityService.FormatAsEUR" />
                            <RadzenCategoryAxis Visible="false" Formatter="@_utilityService.FormatAsDate" />
                            <RadzenColumnOptions Margin="10" />
                            <RadzenLegend Visible="false" />
                        </RadzenChart>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                    <RadzenCard Style="position: relative;">
                        <RadzenStack Gap="0" Orientation="Orientation.Vertical">
                            <RadzenText TextStyle="TextStyle.H5">Credit (@_utilityService.FormatAsDate(lastBalance.DateBalance))</RadzenText>
                            <RadzenStack Orientation="Orientation.Horizontal">
                                <RadzenIcon Icon=@FormatDiffIcon(lastBalance.BalanceValue-prevBalance.BalanceValue) IconStyle=@FormatDiffIconStyle(lastBalance.BalanceValue-prevBalance.BalanceValue)></RadzenIcon>
                                    <RadzenText TextStyle="TextStyle.H6" Class="rz-color-success">was @_utilityService.FormatAsEUR(prevBalance.BalanceValue) (@_utilityService.FormatAsEUR((lastBalance.BalanceValue - prevBalance.BalanceValue)))</RadzenText>
                                              </RadzenStack>

                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.H4" Class="rz-color-success" Style="position: absolute; right: 1.5rem; top: 1rem;">
                            @_utilityService.FormatAsEUR(lastBalance.BalanceValue)
                        </RadzenText>
                        <RadzenChart Style="width: 100%; height: 120px; margin-bottom: -30px;">
                            <RadzenLineSeries Data=@balancesChart ValueProperty="BalanceValue"
                                              CategoryProperty="DateBalance" Title="Balance" Smooth="true" Stroke="var(--rz-success)">
                                <RadzenMarkers MarkerType="MarkerType.Circle" />
                                <RadzenSeriesDataLabels Visible="false" />
                                <RadzenSeriesTrendLine Visible="true" Stroke="var(--rz-danger-dark)" LineType="LineType.Dashed" />
                            </RadzenLineSeries>
                            <RadzenValueAxis Visible="false" Formatter="@_utilityService.FormatAsEUR" />
                            <RadzenCategoryAxis Visible="false" Formatter="@_utilityService.FormatAsDate" />
                            <RadzenColumnOptions Margin="10" />
                            <RadzenLegend Visible="false" />
                        </RadzenChart>
                    </RadzenCard>
                </RadzenColumn>
                @*         <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
        <RadzenCard>
        <RadzenText TextStyle="TextStyle.H6">Progress</RadzenText>
        <RadzenArcGauge Style="width: 100%; height: 120px; margin-top: -30px;">
        <RadzenArcGaugeScale Max="1" Y="0.8" Radius="2">
        <RadzenArcGaugeScaleValue Value=10 FormatString="{0:P0}" />
        </RadzenArcGaugeScale>
        </RadzenArcGauge>
        </RadzenCard>
        </RadzenColumn> *@
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                    <RadzenDataGrid AllowFiltering="false" AllowColumnResize="false" AllowAlternatingRows="true"
                                    AllowSorting="false" AllowPaging="false"
                                    PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="false"
                                    Data="@balancesSummary" TItem="BalancesSummary" Density="Density.Compact">
                        <Columns>

                            <RadzenDataGridColumn TItem="BalancesSummary" Title="Account" Frozen="false">
                                <Template Context="data">
                                    @if (data.AccountName == "Grand Total")
                                    {
                                        <h4 style="white-space:pre-wrap">@data.AccountName</h4>
                                    }
                                    else
                                    {
                                        <h6 style="white-space:pre-wrap">@data.AccountName</h6>
                                    }

                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="BalancesSummary" Title="Date" Frozen="false">
                                <Template Context="data">
                                    @if (data.AccountName == "Grand Total")
                                    {
                                        <h4>@_utilityService.FormatAsDate(data.BalanceDate)</h4>
                                    }
                                    else
                                    {
                                        <h6>@_utilityService.FormatAsDate(data.BalanceDate)</h6>
                                    }

                                </Template>
                            </RadzenDataGridColumn>

                            @*                         <RadzenDataGridColumn TItem="BalancesSummary" Property="Currency" Title="Curr" Frozen="false">
                    </RadzenDataGridColumn> *@

                            <RadzenDataGridColumn TItem="BalancesSummary" Title="Amount" Frozen="false">
                                <Template Context="data">
                                    @if (data.AccountName == "Grand Total")
                                    {
                                        <h4>@_utilityService.FormatAsCurrency(data.BalanceAmount, data.Currency)</h4>
                                    }
                                    else
                                    {
                                        <h6>@_utilityService.FormatAsCurrency(data.BalanceAmount, data.Currency)</h6>
                                    }

                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="BalancesSummary" Title="Diff" Frozen="false">
                                <Template Context="data">
                                    @if (data.AccountName == "Grand Total")
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1px">
                                            <RadzenIcon Icon="@FormatDiffIcon(data.DifferenceAmount)"
                                                        IconStyle="FormatDiffIconStyle(data.DifferenceAmount)" />
                                            <h4>@_utilityService.FormatAsCurrency(data.DifferenceAmount, data.Currency)</h4>

                                        </RadzenStack>
                                    }
                                    else
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1px">
                                            <RadzenIcon Icon="@FormatDiffIcon(data.DifferenceAmount)"
                                                        IconStyle="FormatDiffIconStyle(data.DifferenceAmount)" />
                                            @*                                                         <h6>@FormatAsCurrency(data.DifferenceAmount, data.Currency)</h6> *@
                                            <h6>@_utilityService.FormatAsCurrency(data.DifferenceAmount, data.Currency)</h6>

                                        </RadzenStack>
                                    }

                                </Template>
                            </RadzenDataGridColumn>

                        </Columns>
                    </RadzenDataGrid>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6" SizeLG="8">
                    <RadzenChart>
                        <RadzenLineSeries Smooth="true" Data="@balances" CategoryProperty="DateBalance" Title="Balance"
                                          LineType="LineType.Solid" ValueProperty="BalanceValue">
                            <RadzenMarkers MarkerType="MarkerType.Circle" />
                            <RadzenSeriesDataLabels Visible="false" />
                            <RadzenSeriesTrendLine Visible="true" Stroke="var(--rz-danger-dark)" LineType="LineType.Dashed" />
                            @* <RadzenSeriesAnnotation Visible="true" TItem="BalanceLineChart" Data="@balances[0]" OffsetY="-16" Text="Current" /> *@
                        </RadzenLineSeries>
                        <RadzenValueAxis Visible="true" Formatter="@_utilityService.FormatAsEUR" />
                        <RadzenCategoryAxis Visible="true" Formatter="@_utilityService.FormatAsDate" />
                        <RadzenColumnOptions Margin="10" />
                        <RadzenLegend Visible="false" />
                    </RadzenChart>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>

    }
}
else
{
    <NotAuthorizePage></NotAuthorizePage>
}


@code {
    [Inject]
    public IStatisticService _service { get; set; }
    [Inject]
    public IAccessServices _accessService { get; set; }
    [Inject]
    public IUtilityServices _utilityService { get; set; }

    IList<BalanceLineChart> balances;

    Dashboard? dashboard;

    protected IList<BalancesSummary>? balancesSummary;

    BalanceLineChart? lastBalance;
    BalanceLineChart? prevBalance;
    IList<BalanceLineChart>? balancesChart;

    SpentChart? lastSpent;
    SpentChart? prevSpent;
    IList<SpentChart>? spentChart;

    SalaryChart? lastSalary;
    SalaryChart? prevSalary;
    IList<SalaryChart>? salaryChart;


    protected override async Task OnInitializedAsync()
    {

        if (_accessService.IsAuthorized)
        {
            await retriveData();
        }
    }


    string FormatSalaryDate(SalaryChart salary)
    {
        if (string.IsNullOrEmpty(salary.RefMonth) || string.IsNullOrEmpty(salary.RefYear))
        {
            return "--";

        }

        return string.Concat(salary.RefMonth, " ", salary.RefYear);

    }

    string FormatDiffIcon(double diffAmount)
    {
        switch (diffAmount)
        {
            case > 0:
                return "arrow_upward";

            case < 0:
                return "arrow_downward";

            case 0:
                return "sync_alt";

            default:
                return "";
        }
    }

    Radzen.IconStyle FormatDiffIconStyle(double diffAmount)
    {
        switch (diffAmount)
        {
            case > 0:
                return Radzen.IconStyle.Success;

            case < 0:
                return Radzen.IconStyle.Primary;

            case 0:
                return Radzen.IconStyle.Info;

            default:
                return Radzen.IconStyle.Light;
        }
    }

    private async Task retriveData()
    {
        // balances = await _service.GetBalanceLineChart();
        dashboard = await _service.GetDashboard();


        if (dashboard != null)
        {
            try
            {
                balancesSummary = dashboard.BalancesSummary;

                balances = dashboard.BalanceLineChar.Take(60).ToList();

                lastBalance = dashboard.BalanceLineChar.FirstOrDefault();
                prevBalance = dashboard.BalanceLineChar.Skip(1).FirstOrDefault();
                balancesChart = dashboard.BalanceLineChar.Take(13).ToList();

                lastSpent = dashboard.SpentChar.FirstOrDefault();
                prevSpent = dashboard.SpentChar.Skip(1).FirstOrDefault();
                spentChart = dashboard.SpentChar.Take(13).ToList();

                lastSalary = dashboard.SalaryCharts.OrderByDescending(e => e.RefDate).FirstOrDefault();
                prevSalary = dashboard.SalaryCharts.OrderByDescending(e => e.RefDate).Skip(1).FirstOrDefault();
                salaryChart = dashboard.SalaryCharts.OrderByDescending(e => e.RefDate).Take(13).ToList();

                // NotificationService.Notify(new NotificationMessage
                //     {
                //         Severity = NotificationSeverity.Success,
                //         Summary = "Dashboard",
                //         Detail = $"Updated",
                //         Duration = 2000

                //     });
            }
            catch (Exception ex)
            {

                Console.WriteLine(ex.Message);
            }

        }

    }


}
