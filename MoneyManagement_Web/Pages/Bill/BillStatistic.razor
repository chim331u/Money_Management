@page "/billstatistic"

<MM_WEB.Shared.Components.BreadCrumb path="billstatistic"></MM_WEB.Shared.Components.BreadCrumb>

@if (_accessService.IsAuthorized)
{
    @if (bills != null)
    {
        <RadzenMenu>
            <RadzenStack Gap="2rem" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center">
                <RadzenStack Gap="1rem" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start">
                    <RadzenText>Select Supplier:</RadzenText>
                    <RadzenDropDown @bind-Value=@values Data="suppliers" Name="DropDownMultipleChips" Multiple=true AllowClear=true
                                    Placeholder="Select supplier" Change="@OnChangeDropDown" Chips=true />
                </RadzenStack>
            </RadzenStack>
        </RadzenMenu>
        <br />
        <RadzenStack Gap="1rem" Style="position: relative">

            <RadzenRow>
                    <RadzenRow>
                        @if (billsList != null)
                        {
                            <RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="true" @ref="billGrid"
                                            FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="15" AllowPaging="true"
                                            PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true" ColumnWidth="250px"
                                            Data="@billsList" TItem="Bill" Density="Density.Compact">
                                <Columns>
                                    <RadzenDataGridColumn TItem="Bill" Property="Id" Filterable="false" Title="ID"
                                                          Frozen="true" TextAlign="TextAlign.Center" Width="20px" />

                                    <RadzenDataGridColumn TItem="Bill" Property="Supplier.Name" Title="Supplier" Frozen="true" Width="40px">
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="Bill" Property="Supplier.Type" Title="Type" Frozen="true" Width="40px">
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn TItem="Bill" Property="PaidDate" Title="Paid Date" Width="30px" Frozen="true" FormatString="{0:dd/MM/yyyy}">
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn TItem="Bill" Property="RefPeriodStart" Title="Start Date" Width="30px" Frozen="true" FormatString="{0:dd/MM/yyyy}">
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn TItem="Bill" Property="RefPeriodEnd" Title="End Date" Width="30px" Frozen="true" FormatString="{0:dd/MM/yyyy}">
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn TItem="Bill" Title="Cons." Width="30px" Frozen="true">
                                    <Template Context="data">
                                         @data.Consumption @data.Supplier.UnitMeasure 
                                    </Template>
                                   
                                </RadzenDataGridColumn>

                                    <RadzenDataGridColumn TItem="Bill" Title="Amount" Frozen="true" Width="40px">
                                        <Template Context="data">
                                            @String.Format(new System.Globalization.CultureInfo("it-IT"), "{0:C}", data.Amount)
                                        </Template>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn TItem="Bill" Title="Unit" Frozen="true" Width="40px">
                                        <Template Context="data">
                                           @String.Format(new System.Globalization.CultureInfo("it-IT"), "{0:0.####}", (data.Amount / data.Consumption)) €

                                        </Template>
                                    </RadzenDataGridColumn>

                                </Columns>
                            </RadzenDataGrid>
                        }
                    </RadzenRow>

                @* </RadzenColumn> *@

            </RadzenRow>

        </RadzenStack>
    }
    else
    {
        <p><em>Loading ...</em></p>
    }
}
else
{
    <NotAuthorizePage></NotAuthorizePage>
}

@code {

    [Inject]
    public IAccessServices _accessService { get; set; }
    [Inject]
    public IBillService _service { get; set; }
    [Inject]
    public IUtilityServices _utilityService { get; set; }

    protected IList<Bill>? bills;
    protected IList<List<Bill>>? billsChart;
    protected IList<string>? types;
    protected IList<string>? suppliers;
    IEnumerable<string>? values;
    private List<string>? years;
    string startingYear = DateTime.Now.AddYears(-4).Year.ToString();
    IEnumerable<string>? selectedSupplierList;
    bool showDataLabels = false;
    bool trend = true;
    bool median = false;
    int groupType = 1;
    RadzenDataGrid<Bill>? billGrid;
    protected IList<Bill>? billsList;

    protected override async Task OnInitializedAsync()
    {
        if (_accessService.IsAuthorized)
        {
            await RefreshData();

        }
    }

    protected async Task RefreshData()
    {
        bills = await _service.GetActiveBillList();
        if (bills != null)
        {
            suppliers = bills.OrderBy(e => e.Supplier.Name).Select(x => x.Supplier.Name).Distinct().ToList();
            types = bills.OrderBy(e => e.Supplier.Type).Select(x => x.Supplier.Type).Distinct().ToList();
            years = bills.Select(x => x.PaidDate.Year.ToString()).Distinct().ToList();
        }

        StateHasChanged();
    }

    void OnChange(IEnumerable<string> value)
    {
        selectedSupplierList = value;
        LoadDataChart();
        LoadDataBySupplier();

    }

    void OnChangeDropDown(object value)
    {
        selectedSupplierList = values.Select(x => x).ToList();

        // LoadDataChart();
        LoadDataBySupplier();

    }

    protected async Task dataChange(object item)
    {
        startingYear = item.ToString();
        LoadDataChart();

    }

    private async Task LoadDataBySupplier()
    {
        billsList = bills.Where(x => selectedSupplierList.Contains(x.Supplier.Name)).OrderByDescending(x=>x.PaidDate).ToList();
    }

    private void LoadDataChart()
    {
        billsChart = new List<List<Bill>>();

        if (selectedSupplierList != null)
        {
            //select items in bills where types in value
            billsList = bills.Where(x => selectedSupplierList.Contains(x.Supplier.Type)).ToList();

            foreach (var item in selectedSupplierList)
            {
                var result = bills.Where(x => x.Supplier.Type == item && x.PaidDate >= new DateTime(Convert.ToInt32(startingYear), 1, 1)).ToList();

                switch (groupType)
                {
                    // case 2: //month
                    //     var grouperByMonth = result.GroupBy(y => new { y.PaidDate.Year, y.PaidDate.Month, y.Supplier.Type })
                    //         .Select(t => new Bill { PaidDate = new DateTime(t.Key.Year, t.Key.Month, 1), Amount = t.Sum(c => c.Amount), Supplier.Type = t.Key.Type })
                    //         .OrderByDescending(i => i.TxnDate).ToList();
                    //     billsChart.Add(grouperByMonth);
                    //     break;
                    // case 3: //year
                    //     var grouperByYear = result.GroupBy(y => new { y.PaidDate.Year, y.Area })
                    //         .Select(t => new Bill { PaidDate = new DateTime(t.Key.Year, 12, 1), TxnAmount = t.Sum(c => c.TxnAmount), Area = t.Key.Area })
                    //         .OrderByDescending(i => i.TxnDate).ToList();
                    //     billsChart.Add(grouperByYear);
                    //     break;
                    default:
                        billsChart.Add(result);
                        break;
                }



            }

            //show stats and trx list


            Console.WriteLine($"Value changed to {string.Join(", ", selectedSupplierList)}");
        }
        else
        {
            Console.WriteLine($"No Areas selected");
        }
    }

    private void testChange()
    {
        LoadDataChart();
        Console.WriteLine($"Selected group type: {groupType}");
    }
}