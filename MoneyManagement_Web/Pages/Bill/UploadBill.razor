@page "/uploadbill"
@using System.Net.Http.Headers
@using System.Text
@using UglyToad.PdfPig
@using UglyToad.PdfPig.Content
@using System.Text.RegularExpressions

<MM_WEB.Shared.Components.BreadCrumb path="uploadbill"></MM_WEB.Shared.Components.BreadCrumb>

<RadzenMenu>
    <InputFile OnChange="HandleFileChange" />
    @if (selectedFile != null)
    {
        <RadzenLabel Gap="1rem">File Size: </RadzenLabel>
        <RadzenLabel Style="@($"color: {((selectedFile.Size <= maxFileSize) ? "green" : " red")}")"> @_utilityService.FileSizeFormatted(selectedFile.Size) </RadzenLabel>
        @if (selectedFile.Size <= maxFileSize)
        {
            <RadzenMenuItem Icon="picture_as_pdf" Text="View PDF" Click=@ShowPdf Gap="1rem" />
            <RadzenMenuItem Icon="wysiwyg" Text="View text" Click=@ViewText Gap="1rem" />
            <RadzenMenuItem Icon="data_saver_on" Text="Add to Bill" Click=@NewBill IsBusy=@convertToText BusyText="converting ..." />
            @if (convertToText)
            {
                <RadzenLabel Style="color: yellow"> Converting PDF to text...</RadzenLabel>
            }
        }
        else
        {
            <RadzenLabel Gap="1rem">File exceeds max size : @_utilityService.FileSizeFormatted(maxFileSize) </RadzenLabel>
        }

    }
</RadzenMenu>
<hr />

@if (viewSupplierList && bill.Supplier == null)
{
    <div class="rz-p-sm-12 rz-text-align-start">
        <RadzenDropDown AllowClear="true" Name="Supplier.Name"
                        TValue="Supplier" Class="w-99" Placeholder="Select a Supplier"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        AllowFiltering="true" TextProperty="Name"
                        Data=@suppliers @bind-Value="bill.Supplier" Change="@(args => supplierSelected(args))" />
    </div>

}

@if (bill != null && bill.Supplier != null)
{
