            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="1">
            <RadzenStack>
                <RadzenFormField Text="Amount" Variant="Variant.Text">
                    <RadzenNumeric @bind-Value="bill.Amount" Style="width:100%; display: block" Name="Amount" />
                </RadzenFormField>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="2">
            <RadzenStack>
                <RadzenFormField Text="Period Start" Variant="Variant.Text">
                    <RadzenDatePicker @bind-Value=@bill.RefPeriodStart ShowTime="false" HourFormat="12" DateFormat="dd/MM/yyyy"
                                      Style="width:100%; display: block" Name="RefPeriodStart">
                    </RadzenDatePicker>
                </RadzenFormField>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="2">
            <RadzenStack>
                <RadzenFormField Text="Period End" Variant="Variant.Text">
                    <RadzenDatePicker @bind-Value=@bill.RefPeriodEnd ShowTime="false" HourFormat="12" DateFormat="dd/MM/yyyy"
                                      Style="width:100%; display: block" Name="RefPeriodEnd">
                    </RadzenDatePicker>
                </RadzenFormField>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="1">
            <RadzenStack>
                <RadzenFormField Text="Consumption" Variant="Variant.Text">
                    <RadzenNumeric @bind-Value="bill.Consumption" Style="width:100%; display: block" Name="Consumption" />
                </RadzenFormField>
            </RadzenStack>
        </RadzenColumn>
        @*         <RadzenColumn Size="12" SizeSM="1">
    <RadzenStack>
    <RadzenFormField Text="Note" Variant="Variant.Text">
    <RadzenTextBox @bind-Value="bill.Note" Style="width:100%; display: block" Name="Note" />
    </RadzenFormField>
    </RadzenStack>
    </RadzenColumn> *@
        <RadzenColumn Size="12" SizeSM="1">
            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                          Size="ButtonSize.Small" ButtonType="ButtonType.Submit" Text="Save" Click="@SaveBill"></RadzenButton>
        </RadzenColumn>
    </RadzenRow>

    if (selectedSupplier != null)
    {
        <hr />
        @*         <RadzenRow Gap="1rem"> *@
        <RadzenMenu>
            Supplier: @selectedSupplier.Name
            <RadzenMenuItem Text="New" Icon="add" Click="@InsertRowReadInBill" Gap="1rem"></RadzenMenuItem>
            <RadzenMenuItem Text="Refresh" Icon="autorenew" Click="@RefreshCompiledBill" Gap="1rem"></RadzenMenuItem>
            <RadzenMenuItem Text="Regex Help" Icon="info" Click="@openRegexHelper" Gap="1rem"></RadzenMenuItem>
        </RadzenMenu>
        @*         </RadzenRow> *@
        <br />
        <RadzenRow Gap="1rem">
            <RadzenDataGrid AllowFiltering="false" AllowColumnResize="true" AllowAlternatingRows="true" @ref="readInBillGrid"
                            AllowSorting="true" PageSize="15" AllowPaging="true"
                            PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true" ColumnWidth="250px"
                            Data="@readInBill"
                            TItem="ReadInBill" LogicalFilterOperator="LogicalFilterOperator.Or"
                            EditMode="DataGridEditMode.Single" RowUpdate="@OnUpdateRowReadInBill" RowCreate="@OnCreateRowReadInBill"
                            Sort="@ResetReadInBill" Page="@ResetReadInBill" Filter="@ResetReadInBill"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Density="Density.Compact">

                <Columns>
                    <RadzenDataGridColumn TItem="ReadInBill" Property="Id" Filterable="false" Title="ID"
                                          Frozen="true" Width="20px" TextAlign="TextAlign.Center" />

                    <RadzenDataGridColumn TItem="ReadInBill" Property="BillProperty" Title="Property" Frozen="true" Width="50px">
                        <EditTemplate Context="readInBill">
                            <RadzenDropDown AllowClear="true" Name="readInBill.BillProperty"
