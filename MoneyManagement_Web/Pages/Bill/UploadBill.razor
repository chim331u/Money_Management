                            <RadzenRequiredValidator Text="Property is required" Component="readInBill.BillProperty" Popup="false" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="ReadInBill" Property="PropertyDataType" Title="Data Type" Frozen="true" Width="50px">
                        <EditTemplate Context="readInBill">
                            <RadzenDropDown AllowClear="true" Name="readInBill.PropertyDataType"
                                            TValue="string" Class="w-99" Placeholder="Select a DataType"
                                            AllowFiltering="true"
                                            Data=@billTypes @bind-Value="readInBill.PropertyDataType" />
                            <RadzenRequiredValidator Text="DataType is required" Component="readInBill.PropertyDataType" Popup="false" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="ReadInBill" Property="KeyWord" Title="KeyWord" Frozen="true" Width="50px">
                        <EditTemplate Context="readInBill">
                            <RadzenTextBox @bind-Value="readInBill.KeyWord" Style="width:100%; display: block" Name="KeyWord" />
                            <RadzenRequiredValidator Text="KeyWord is required" Component="KeyWord" Popup="false" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="ReadInBill" Property="RegexString" Title="RegexString" Frozen="true" Width="50px">
                        <EditTemplate Context="readInBill">
                            <RadzenTextBox @bind-Value="readInBill.RegexString" Style="width:100%; display: block" Name="RegexString" />
                            <RadzenRequiredValidator Text="RegexString is required" Component="RegexString" Popup="false" />
                        </EditTemplate>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="ReadInBill" Property="Note" Title="Note" Frozen="true" Width="40px">
