                </RadzenFormField>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="2">
            <RadzenStack>
                <RadzenFormField Text="Bill Number" Variant="Variant.Text">
                    <RadzenTextBox @bind-Value="@bill.BillNumber" />
                </RadzenFormField>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="2">
            <RadzenStack>
                <RadzenFormField Text="Paid Date" Variant="Variant.Text">
