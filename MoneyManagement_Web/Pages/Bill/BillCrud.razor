@page "/billcrud"
<MM_WEB.Shared.Components.BreadCrumb path="billcrud"></MM_WEB.Shared.Components.BreadCrumb>
@if (_accessService.IsAuthorized)
{
    @if (bills == null)
    {
        <p><em>Loading ...</em></p>
    }
    else
    {
        <RadzenMenu>
            <RadzenMenuItem Text="New" Icon="add" Click="@InsertRow" Disabled=@(billToInsert != null || billToUpdate != null)></RadzenMenuItem>
        </RadzenMenu>
        <br />
        <RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="true" @ref="billGrid"
                        FilterMode="FilterMode.SimpleWithMenu" AllowSorting="true" PageSize="10" AllowPaging="true"
                        PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true" ColumnWidth="250px"
                        Data="@bills" TItem="Bill" LogicalFilterOperator="LogicalFilterOperator.Or"
                        EditMode="DataGridEditMode.Single" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow"
                        Sort="@Reset" Page="@Reset" Filter="@Reset" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Density="Density.Compact">
            <Columns>
                <RadzenDataGridColumn TItem="Bill" Property="Id" Title="ID"
                                      Frozen="true" Width="20px" TextAlign="TextAlign.Center" />

                <RadzenDataGridColumn TItem="Bill" Property="Supplier.Name" Title="Supplier" Frozen="true" Width="60px">
                    <Template Context="bill">
                        <p style="white-space:pre-wrap">@bill.Supplier.Name</p>
                    </Template>
                    <EditTemplate Context="bill">
                        <RadzenDropDown AllowClear="true" Name="Supplier.Name"
                                        TValue="Supplier" Class="w-99" Placeholder="Select a Supplier"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        AllowFiltering="true" TextProperty="Name"
                                        Data=@suppliers @bind-Value="bill.Supplier" />
                        <RadzenRequiredValidator Text="Supplier is required" Component="Supplier.Name" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Bill" Property="Supplier.Type" Title="Type" Frozen="true" Width="40px">
                    <Template Context="bill">
                        @bill.Supplier.Type
                    </Template>
                    <EditTemplate>

                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Bill" Property="BillNumber" Title="Bill Number" Frozen="true" Width="30px">
                    <EditTemplate Context="bill">
                        <RadzenTextBox @bind-Value="bill.BillNumber" Style="width:100%; display: block" Name="BillNumber" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Bill" Property="PaidDate" Title="Paid Date" Frozen="true" Width="40px" FormatString="{0:MM/yyyy}">
                    <EditTemplate Context="bill">
                        <RadzenDatePicker @bind-Value=@bill.PaidDate ShowTime="false" HourFormat="12" DateFormat="dd/MM/yyyy"
                                          Style="width:100%; display: block" Name="PaidDate">
                        </RadzenDatePicker>
                        <RadzenRequiredValidator Text="Paid Date is required" Component="PaidDate" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Bill" Property="Amount" Title="Bill Amount" Frozen="true" Width="40px">
                    <Template Context="data">
                        @String.Format(new System.Globalization.CultureInfo("it-IT"), "{0:C}", data.Amount)
                    </Template>
                    <EditTemplate Context="bill">
                        <RadzenNumeric @bind-Value="bill.Amount" Style="width:100%; display: block" Name="Amount" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Bill" Property="RefPeriodStart" Title="Start Period" Frozen="true" Width="40px" FormatString="{0:MM/yyyy}">
                    <EditTemplate Context="bill">
                        <RadzenDatePicker @bind-Value=@bill.RefPeriodStart ShowTime="false" HourFormat="12" DateFormat="dd/MM/yyyy"
                                          Style="width:100%; display: block" Name="RefPeriodStart">
                        </RadzenDatePicker>
                        <RadzenRequiredValidator Text="Start Date is required" Component="RefPeriodStart" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Bill" Property="RefPeriodEnd" Title="End Period" Frozen="true" Width="40px" FormatString="{0:MM/yyyy}">
                    <EditTemplate Context="bill">
                        <RadzenDatePicker @bind-Value=@bill.RefPeriodEnd ShowTime="false" HourFormat="12" DateFormat="dd/MM/yyyy"
                                          Style="width:100%; display: block" Name="RefPeriodEnd">
                        </RadzenDatePicker>
                        <RadzenRequiredValidator Text="End Date is required" Component="RefPeriodEnd" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Bill" Property="Consumption" Title="Consumption" Frozen="true" Width="50px">
                    <Template Context="data">
                        <p style="white-space:pre-wrap">@data.Supplier.UnitMeasure @String.Format(new System.Globalization.CultureInfo("it-IT"), "{0:N2}", data.Consumption)</p>
                    </Template>
                    <EditTemplate Context="bill">
                        <RadzenNumeric @bind-Value="bill.Consumption" Style="width:100%; display: block" Name="Consumption" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Bill" Property="FullPathFileName" Title="FullPathFileName" Frozen="true" Width="50px">
                    <Template Context="bill">
                        <p style="white-space:pre-wrap">@bill.FullPathFileName</p>
                    </Template>
                    <EditTemplate Context="bill">
                        <RadzenTextBox @bind-Value="bill.FullPathFileName" Style="width:100%; display: block" Name="FullPathFileName" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Bill" Property="Note" Title="Note" Frozen="true" Width="30px">
                    <EditTemplate Context="bill">
                        <RadzenTextBox @bind-Value="bill.Note" Style="width:100%; display: block" Name="Note" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Bill" Context="bill" Filterable="false" Sortable="false"
                                      TextAlign="TextAlign.Right" Width="10%">
                    <Template Context="bill">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(args => EditRow(bill))" @onclick:stopPropagation="true">
                        </RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter"
                                      Size="ButtonSize.Small" class="my-1 ms-1" Click="@(args => DeleteRow(bill))" @onclick:stopPropagation="true">
                        </RadzenButton>
                    </Template>
                    <EditTemplate Context="bill">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                      Size="ButtonSize.Small" Click="@((args) => SaveRow(bill))">
                        </RadzenButton>
                        <RadzenButton Icon="undo" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      class="my-1 ms-1" Click="@((args) => CancelEdit(bill))">
                        </RadzenButton>
                    </EditTemplate>
                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>

    }
}
else
{
    <NotAuthorizePage></NotAuthorizePage>
}

@code {
    [Inject]
    public IBillService _service { get; set; }
    [Inject]
    public IAnchillaryService _anchillaryService { get; set; }
    [Inject]
    public IAccessServices _accessService { get; set; }
    [Inject]
    public IUtilityServices _utilityService { get; set; }

    protected IList<Bill>? bills;
    protected IList<Supplier>? suppliers;

    protected override async Task OnInitializedAsync()
    {

        if (_accessService.IsAuthorized)
        {
            await RefreshData();
            suppliers = await _anchillaryService.GetActiveSupplierList();
        }
    }

    protected async Task RefreshData()
    {
        bills = await _service.GetActiveBillList();
        StateHasChanged();

    }

    Bill? billToUpdate;
    Bill? billToInsert;
    RadzenDataGrid<Bill>? billGrid;

    async Task EditRow(Bill item)
    {
        billToUpdate = item;

        await billGrid.EditRow(item);
    }

    async void OnUpdateRow(Bill item)
    {
        if (item == billToInsert)
        {
            billToInsert = null;
        }

        billToUpdate = null;

        var result = await _service.UpdateBill(item);

        if (result != null)
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Bill Update",
                        Detail = $"Bill updated",
                        Duration = 4000

                    });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error Update",
                        Detail = $"Bill NOT updated",
                        Duration = 4000

                    });
        }
    }

    async void OnCreateRow(Bill item)
    {
        var result = await _service.AddBill(item);

        if (result != null)
        {
            billToInsert = null;
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "New Bill Created",
                        Detail = $"Bill created",
                        Duration = 4000

                    });
            await RefreshData();
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error",
                        Detail = "Error adding New Bill",
                        Duration = 4000

                    });
        }


    }

    async Task SaveRow(Bill item)
    {
        await billGrid.UpdateRow(item);
    }

    async void CancelEdit(Bill item)
    {
        if (billToInsert != null)
        {
            billToInsert = null;
        }

        billToUpdate = null;

        billGrid.CancelEditRow(item);

        //item = await _service.GetBill(item.Id);
        billGrid.Reload();
        StateHasChanged();

    }

    protected async Task InsertRow()
    {
        billToInsert = new Bill();
        billToInsert.RefPeriodStart = DateTime.Now;
        billToInsert.RefPeriodEnd = DateTime.Now;
        billToInsert.PaidDate = DateTime.Now;

        await billGrid.InsertRow(billToInsert);

    }

    async Task DeleteRow(Bill item)
    {
        var dialogResult = await DialogService.OpenAsync("Confirm Delete", ds =>
    @<RadzenStack Gap="1.5rem">
        <p>Do you want delete the bill <b>@item.Id</b>?</p>
        <RadzenStack Gap="2rem" Class="rz-p-4 rz-p-md-12">
            <RadzenRow AlignItems="AlignItems.Center" Class="rz-mt-4">
                <RadzenButton Text="No" Click="() => ds.Close(false)" ButtonStyle="ButtonStyle.Light" />
                <RadzenButton Click="() => ds.Close(true)" Text="Yes" ButtonStyle="ButtonStyle.Secondary"></RadzenButton>
            </RadzenRow>
        </RadzenStack>
    </RadzenStack>
    );

        if (dialogResult != null && dialogResult)
        {

            if (item == billToInsert)
            {
                billToInsert = null;
            }

            if (item == billToUpdate)
            {
                billToUpdate = null;
            }

            var result = await _service.DeleteBill(item);


            if (result != null)
            {
                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Bill Deleted",
                        Detail = $"Bill deleted",
                        Duration = 4000

                    });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error",
                        Detail = "Error deleting Bill",
                        Duration = 4000

                    });
            }
            await billGrid.Reload();
            await RefreshData();
        }
    }

    void Reset()
    {
        billToInsert = null;
        billToUpdate = null;
    }


    #region Tooltips


    #endregion

}
