@page "/accountpage"
@using MoneyManagement_Data.DTOs
<MM_WEB.Shared.Components.BreadCrumb path="accountpage"></MM_WEB.Shared.Components.BreadCrumb>
@if (_accessService.IsAuthorized)
{
    @if (accounts == null)
    {
        <p><em>Loading ...</em></p>
    }
    else
    {
        <RadzenMenu>
            <RadzenMenuItem Text="New" Icon="add" Click="@InsertRow" Disabled=@(accountToInsert != null || accountToUpdate != null)></RadzenMenuItem>
        </RadzenMenu>
        <br />
        <RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="true" @ref="accountGrid"
                        FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="15" AllowPaging="true"
                        PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true" ColumnWidth="250px"
                        Data="@accounts" TItem="AccountMasterData" LogicalFilterOperator="LogicalFilterOperator.Or"
                        EditMode="DataGridEditMode.Single" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow"
                        Sort="@Reset" Page="@Reset" Filter="@Reset" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Density="Density.Compact">
            <Columns>
                <RadzenDataGridColumn TItem="AccountMasterData" Property="Id" Filterable="false" Title="ID"
                                      Frozen="true" Width="20px" TextAlign="TextAlign.Center" />

                <RadzenDataGridColumn TItem="AccountMasterData" Title="Name" Frozen="true" Width="50px">
                    <Template Context="data">
                        <p style="white-space:pre-wrap">@data.Name</p>
                    </Template>
                    <EditTemplate Context="account">
                        <RadzenTextBox @bind-Value="account.Name" Style="width:100%; display: block" Name="Name" />
                        <RadzenRequiredValidator Text="Name is required" Component="Name" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="AccountMasterData" Property="Conto" Title="Conto" Frozen="true" Width="50px">
                    <EditTemplate Context="account">
                        <RadzenTextBox @bind-Value="account.Conto" Style="width:100%; display: block" Name="Conto" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="AccountDto" Property="Currency.Name" Title="Currency" Frozen="true" Width="60px">
                    <EditTemplate Context="account">
                        <RadzenDropDown AllowClear="true" Name="Currency.Name"
                                        TValue="Currency" Class="w-99" Placeholder="Select a Currency"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        AllowFiltering="true" TextProperty="Name"
                                        Data=@currencyList @bind-Value="account.Currency" />
                        <RadzenRequiredValidator Text="Currency Name" Component="Currency.Name" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="AccountDto" Property="Description" Title="Description" Frozen="true" Width="50px">
                    <EditTemplate Context="account">
                        <RadzenTextBox @bind-Value="account.Description" Style="width:100%; display: block" Name="Description" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="AccountDto" Property="BankMasterData.Name" Title="Bank" Frozen="true" Width="60px">
                    <EditTemplate Context="account">
                        <RadzenDropDown AllowClear="true" Name="BankMasterData.Name"
                                        TValue="BankMasterData" Class="w-99" Placeholder="Select a Bank"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        AllowFiltering="true" TextProperty="Name"
                                        Data=@banks @bind-Value="account.BankMasterData" />
                        <RadzenRequiredValidator Text="Bank Name" Component="BankMasterData.Name" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="AccountDto" Title="Type" Frozen="true" Width="50px">
                    <Template Context="data">
                        <RadzenBadge IsPill="true" Variant="Variant.Outlined" BadgeStyle=@AccountTypeStyle(data.AccountType) Text="@data.AccountType" />
                    </Template>
                    <EditTemplate Context="account">
                        <RadzenAutoComplete @bind-Value=@account.AccountType Data=@accountTypes Style="width:100%; display: block" 
                        Name="AccountType" />
                        <RadzenRequiredValidator Text="Account Type" Component="AccountType" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AccountDto" Property="Iban" Title="Iban" Frozen="true" Width="50px">
                    <EditTemplate Context="account">
                        <RadzenTextBox @bind-Value="account.Iban" Style="width:100%; display: block" Name="Iban" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="AccountDto" Property="Note" Title="Note" Frozen="true" Width="50px">
                    <EditTemplate Context="account">
                        <RadzenTextBox @bind-Value="account.Note" Style="width:100%; display: block" Name="Note" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AccountDto" Context="account" Filterable="false" Sortable="false"
                                      TextAlign="TextAlign.Right" Width="10%">
                    <Template Context="account">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(args => EditRow(account))" @onclick:stopPropagation="true">
                        </RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter"
                                      Size="ButtonSize.Small" class="my-1 ms-1" Click="@(args => DeleteRow(account))" @onclick:stopPropagation="true">
                        </RadzenButton>
                    </Template>
                    <EditTemplate Context="account">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                      Size="ButtonSize.Small" Click="@((args) => SaveRow(account))">
                        </RadzenButton>
                        <RadzenButton Icon="undo" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      class="my-1 ms-1" Click="@((args) => CancelEdit(account))">
                        </RadzenButton>
                    </EditTemplate>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>

    }
}
else
{
    <NotAuthorizePage></NotAuthorizePage>
}

@code {
    [Inject]
    public IBankAccountService _service { get; set; }
    [Inject]
    public IAccessServices _accessService { get; set; }
    [Inject]
    public IAnchillaryService _anchillaryService { get; set; }

    protected IList<AccountDto>? accounts;
    protected IList<BankMasterData>? banks;

    protected IList<Currency> currencyList;
    protected IList<string>? accountTypes;

    protected override async Task OnInitializedAsync()
    {
        if (_accessService.IsAuthorized)
        {
            await RefreshData();

            banks = await _service.GetActiveBankList();

            currencyList = await _anchillaryService.GetActiveCurrencyList();

            accountTypes = accounts.Select(c => c.AccountType).Distinct().ToList();
        }
    }

    protected Radzen.BadgeStyle AccountTypeStyle(string item)
    {
        switch (item)
        {
            case "Available":
                return Radzen.BadgeStyle.Success;
            case "Block":
                return Radzen.BadgeStyle.Danger;
            case "Credit":
                return Radzen.BadgeStyle.Secondary;

            default:
                return Radzen.BadgeStyle.Info;
        }
    }

    protected async Task RefreshData()
    {
        accounts = (await _service.GetActiveAccountList()).OrderBy(e => e.AccountType).ThenBy(e => e.Name).ToList();
        StateHasChanged();

    }

    AccountDto? accountToUpdate;
    AccountDto? accountToInsert;
    RadzenDataGrid<AccountDto>? accountGrid;

    protected AccountDto originalItem;

    async Task EditRow(AccountDto item)
    {
        accountToUpdate = item;
        originalItem = new AccountDto()
            {
                Id = item.Id,
                Name = item.Name,
                Conto = item.Conto,
                Description = item.Description,
                Iban = item.Iban,
                Bic = item.Bic,
                AccountType = item.AccountType,
                Note = item.Note,
            };
        await accountGrid.EditRow(item);
    }

    async void OnUpdateRow(AccountDto item)
    {
        if (item == accountToInsert)
        {
            accountToInsert = null;
        }

        accountToUpdate = null;

        var result = await _service.UpdateAccount(item);

        if (result != null)
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Account Update",
                    Detail = $"Account {result.Name} updated",
                    Duration = 4000

                });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error Update",
                    Detail = $"Account NOT updated",
                    Duration = 4000

                });
        }
    }

    async void OnCreateRow(AccountDto item)
    {
        var result = await _service.AddAccount(item);

        accountToInsert = null;

        if (result != null)
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "New AccountMasterData Created",
                    Detail = $"AccountMasterData {result.Name} created",
                    Duration = 4000

                });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = "Error adding New AccountMasterData",
                    Duration = 4000

                });
        }

        await RefreshData();
    }

    async Task SaveRow(AccountDto item)
    {
        await accountGrid.UpdateRow(item);
    }

    async void CancelEdit(AccountDto item)
    {
        if (accountToInsert != null)
        {
            accountToInsert = null;
        }

        accountToUpdate = null;

        accountGrid.CancelEditRow(item);

        item = originalItem;

        StateHasChanged();

    }

    protected async Task InsertRow()
    {
        accountToInsert = new AccountDto();

        await accountGrid.InsertRow(accountToInsert);

    }

    async Task DeleteRow(AccountDto item)
    {
        var dialogResult = await DialogService.OpenAsync("Confirm Delete", ds =>
            @<RadzenStack Gap="1.5rem">
                <p>Do you want delete the account <b>@item.Name</b>?</p>
                <RadzenStack Gap="2rem" Class="rz-p-4 rz-p-md-12">
                    <RadzenRow AlignItems="AlignItems.Center" Class="rz-mt-4">
                        <RadzenButton Text="No" Click="() => ds.Close(false)" ButtonStyle="ButtonStyle.Light" />
                        <RadzenButton Click="() => ds.Close(true)" Text="Yes" ButtonStyle="ButtonStyle.Secondary"></RadzenButton>
                    </RadzenRow>
                </RadzenStack>
        </RadzenStack>
    );

        if (dialogResult != null && dialogResult)
        {
            if (item == accountToInsert)
            {
                accountToInsert = null;
            }

            if (item == accountToUpdate)
            {
                accountToUpdate = null;
            }

            var result = await _service.DeleteAccount(item);


            if (result != null)
            {
                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Account Deleted",
                        Detail = $"Account {result.Name} deleted",
                        Duration = 4000

                    });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error",
                        Detail = "Error deleting Account",
                        Duration = 4000

                    });
            }
            await accountGrid.Reload();
            await RefreshData();
        }
    }

    void Reset()
    {
        accountToInsert = null;
        accountToUpdate = null;
    }


    #region Tooltips


    #endregion

}
