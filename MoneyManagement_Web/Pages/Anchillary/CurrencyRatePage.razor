@page "/currencyrate"
<MM_WEB.Shared.Components.BreadCrumb path="currencyrate"></MM_WEB.Shared.Components.BreadCrumb>
@if (_accessService.IsAuthorized)
{
    @if (currencyRate == null)
    {
        <p><em>Loading ...</em></p>
    }
    else
    {

        <RadzenMenu>
            @* <RadzenMenuItem Gap="100px" Text="New" Icon="add" Click="@InsertRow" Disabled=@(CurrencyConversionRateToInsert != null || CurrencyConversionRateToUpdate != null)></RadzenMenuItem>
            <RadzenMenuItem Text="Update Rates" Icon="published_with_changes" Click="UpdateRates"></RadzenMenuItem>
            <RadzenMenuItem Text="Clear Unused" Icon="clear_all" Click="ClearUnused" ></RadzenMenuItem>            
             *@
            <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Text="New" Icon="add" Click="@InsertRow" Disabled=@(CurrencyConversionRateToInsert != null || CurrencyConversionRateToUpdate != null)></RadzenButton>


            <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Text="Update Rates" 
            Icon="published_with_changes" Click="UpdateRates" IsBusy=@isRateUpdating BusyText="Wait ..."></RadzenButton>
            <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Text="Clear Unused" 
            Icon="clear_all" Click="ClearUnused" IsBusy=@isDeletingUnusedRates BusyText="Wait ..."></RadzenButton>

        
        </RadzenMenu>

        <br />
        <RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="true" @ref="CurrencyConversionRateGrid"
                        FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="15" AllowPaging="true"
                        PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true" ColumnWidth="250px"
                        Data="@currencyRate" TItem="CurrencyConversionRate" LogicalFilterOperator="LogicalFilterOperator.Or"
                        EditMode="DataGridEditMode.Single" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow"
                        Sort="@Reset" Page="@Reset" Filter="@Reset" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Density="Density.Compact">
            <Columns>
                <RadzenDataGridColumn TItem="CurrencyConversionRate" Property="Id" Filterable="false" Title="ID"
                                      Frozen="true" Width="10px" TextAlign="TextAlign.Center" />

                <RadzenDataGridColumn TItem="CurrencyConversionRate" Property="CurrencyCodeALF3" Title="Currency Code" Frozen="true" Width="50px">
                    <EditTemplate Context="CurrencyConversionRate">
                        <RadzenTextBox @bind-Value="CurrencyConversionRate.CurrencyCodeALF3" Style="width:100%; display: block" Name="CurrencyCodeALF3" />
                        <RadzenRequiredValidator Text="Code is required" Component="CurrencyCodeALF3" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="CurrencyConversionRate" Property="RateValue" Title="Rate Value" Frozen="true" Width="50px">
                    <EditTemplate Context="CurrencyConversionRate">
                        <RadzenNumeric @bind-Value="CurrencyConversionRate.RateValue" Style="width:100%; display: block" Name="RateValue" />
                        <RadzenRequiredValidator Text="Rate is required" Component="RateValue" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="CurrencyConversionRate" Property="ReferringDate" Title="Referring Date" Frozen="true" Width="50px">
                    <EditTemplate Context="CurrencyConversionRate">
                        <RadzenDatePicker @bind-Value="CurrencyConversionRate.ReferringDate" Style="width:100%; display: block" Name="ReferringDate" />
                        <RadzenRequiredValidator Text="Code is required" Component="ReferringDate" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="CurrencyConversionRate" Context="CurrencyConversionRate" Filterable="false" Sortable="false"
                                      TextAlign="TextAlign.Right" Width="10%">
                    <Template Context="CurrencyConversionRate">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(args => EditRow(CurrencyConversionRate))" @onclick:stopPropagation="true">
                        </RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter"
                                      Size="ButtonSize.Small" class="my-1 ms-1" Click="@(args => DeleteRow(CurrencyConversionRate))" @onclick:stopPropagation="true">
                        </RadzenButton>
                    </Template>
                    <EditTemplate Context="CurrencyConversionRate">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                      Size="ButtonSize.Small" Click="@((args) => SaveRow(CurrencyConversionRate))">
                        </RadzenButton>
                        <RadzenButton Icon="undo" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      class="my-1 ms-1" Click="@((args) => CancelEdit(CurrencyConversionRate))">
                        </RadzenButton>
                    </EditTemplate>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>

    }
}
else
{
    <NotAuthorizePage></NotAuthorizePage>
}

@code {
    [Inject]
    public IAnchillaryService _service { get; set; }
    [Inject]
    public IAccessServices _accessService { get; set; }
    [Inject]
    public IUtilityServices _utilityService { get; set; }

    protected IList<CurrencyConversionRate>? currencyRate;
    bool isDeletingUnusedRates = false;
    bool isRateUpdating = false;

    protected override async Task OnInitializedAsync()
    {

        if (_accessService.IsAuthorized)
        {
            await RefreshData();
        }

    }



    protected async Task RefreshData()
    {
        currencyRate = await _service.GetActiveCurrencyConversionList();
        StateHasChanged();

    }

    CurrencyConversionRate? CurrencyConversionRateToUpdate;
    CurrencyConversionRate? CurrencyConversionRateToInsert;
    RadzenDataGrid<CurrencyConversionRate>? CurrencyConversionRateGrid;

    async Task EditRow(CurrencyConversionRate item)
    {
        CurrencyConversionRateToUpdate = item;

        await CurrencyConversionRateGrid.EditRow(item);
    }

    async void OnUpdateRow(CurrencyConversionRate item)
    {
        if (item == CurrencyConversionRateToInsert)
        {
            CurrencyConversionRateToInsert = null;
        }

        CurrencyConversionRateToUpdate = null;

        var result = await _service.UpdateCurrencyConversion(item);

        if (result != null)
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = "Currency Rate Update",
                    Detail = $"Currency Rate {result.CurrencyCodeALF3} updated",
                    Duration = 4000

                });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error Update",
                    Detail = $"Currency Rate NOT updated",
                    Duration = 4000

                });
        }
    }

    async void OnCreateRow(CurrencyConversionRate item)
    {
        var result = await _service.AddCurrencyConversion(item);

        CurrencyConversionRateToInsert = null;

        if (result != null)
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = "New Currency Rate Created",
                    Detail = $"Currency Rate {result.CurrencyCodeALF3} created",
                    Duration = 4000

                });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = "Error adding New Currency Rate",
                    Duration = 4000

                });
        }

        await RefreshData();
    }

    async Task SaveRow(CurrencyConversionRate item)
    {
        await CurrencyConversionRateGrid.UpdateRow(item);
    }

    async void CancelEdit(CurrencyConversionRate item)
    {
        if (CurrencyConversionRateToInsert != null)
        {
            CurrencyConversionRateToInsert = null;
        }

        CurrencyConversionRateToUpdate = null;



        CurrencyConversionRateGrid.CancelEditRow(item);
        item = await _service.GetCurrencyConversion(item.Id);

        StateHasChanged();

    }

    protected async Task InsertRow()
    {
        CurrencyConversionRateToInsert = new CurrencyConversionRate();

        await CurrencyConversionRateGrid.InsertRow(CurrencyConversionRateToInsert);

    }

    async Task DeleteRow(CurrencyConversionRate item)
    {
        var dialogResult = await DialogService.OpenAsync("Confirm Delete", ds =>
     @<RadzenStack Gap="1.5rem">
         <p>Do you want delete the rate for <b>@item.CurrencyCodeALF3</b>?</p>
         <RadzenStack Gap="2rem" Class="rz-p-4 rz-p-md-12">
             <RadzenRow AlignItems="AlignItems.Center" Class="rz-mt-4">
                 <RadzenButton Text="No" Click="() => ds.Close(false)" ButtonStyle="ButtonStyle.Light" />
                 <RadzenButton Click="() => ds.Close(true)" Text="Yes" ButtonStyle="ButtonStyle.Secondary"></RadzenButton>
             </RadzenRow>
         </RadzenStack>
        </RadzenStack>
    );

        if (dialogResult != null && dialogResult)
        {
            if (item == CurrencyConversionRateToInsert)
            {
                CurrencyConversionRateToInsert = null;
            }

            if (item == CurrencyConversionRateToUpdate)
            {
                CurrencyConversionRateToUpdate = null;
            }

            var result = await _service.DeleteCurrencyConversion(item);


            if (result != null)
            {
                await CurrencyConversionRateGrid.Reload();


                await RefreshData();

                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Info,
                        Summary = "Currency Rate Deleted",
                        Detail = $"Currency Rate {result.CurrencyCodeALF3} deleted",
                        Duration = 4000

                    });

            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error",
                        Detail = "Error deleting Currency Rate",
                        Duration = 4000

                    });
            }

        }

    }

    void Reset()
    {
        CurrencyConversionRateToInsert = null;
        CurrencyConversionRateToUpdate = null;
    }

    private async Task ClearUnused()
    {
        isDeletingUnusedRates = true;

        var result = await _service.ClearUnusedRates();
        isDeletingUnusedRates = false;

        if (result != null)
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Rates Updated",
                    Detail = result,
                    Duration = 4000

                });

            await RefreshData();
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Rates NOT Updates",
                    Detail = $"Currency Rate NOT updated",
                    Duration = 4000

                });
        }

    }

    private async Task UpdateRates()
    {
        isRateUpdating = true;
        var result = await _service.UpdateCurrencyRates();
        isRateUpdating = false;
        if (result != null)
        {
            switch (result)
            {
                case "1":

                    NotificationService.Notify(new NotificationMessage
                        {
                            Severity = NotificationSeverity.Info,
                            Summary = "Rates Updates",
                            Detail = $"Currency Rate already updated",
                            Duration = 4000
                        });

                    break;

                case "0":

                    NotificationService.Notify(new NotificationMessage
                        {
                            Severity = NotificationSeverity.Success,
                            Summary = "Rates Updates",
                            Detail = $"Currency Rate updated",
                            Duration = 4000

                        });

                    await RefreshData();
                    break;
                case "-1":
                    NotificationService.Notify(new NotificationMessage
                        {
                            Severity = NotificationSeverity.Warning,
                            Summary = "Rates NOT Updates",
                            Detail = $"Currency Rate NOT updated",
                            Duration = 4000

                        });
                    break;
                case "-2":
                    NotificationService.Notify(new NotificationMessage
                        {
                            Severity = NotificationSeverity.Error,
                            Summary = "Rates NOT Updates",
                            Detail = $"Currency Rate NOT updated",
                            Duration = 4000

                        });
                    break;

                default:
                    break;
            }
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Rates NOT Updates",
                    Detail = $"Currency Rate NOT updated",
                    Duration = 4000

                });
        }

    }

    #region Tooltips

    private string GetFormattedDate(DateTime dateTime)
    {

        return dateTime.ToString("yyyy-MM-dd H:mm:ss");

    }

    #endregion

}
