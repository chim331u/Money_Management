@code {

    [Inject]
    public IAccessServices _accessService { get; set; }
    [Inject]
    public IUtilityServices _utilityService { get; set; }

    private string[]? Log;

    protected override async Task OnInitializedAsync()
    {
        if (_accessService.IsAuthorized)
        {
            await GetLog();
        }
    }

    public async Task GetLog()
    {
        var _log = await _utilityService.GetLog();

        if (_log == null)
        {
            Log = null;
        }
        else
        {
            Log = _log.Split(new string[] { Environment.NewLine }, StringSplitOptions.RemoveEmptyEntries);
        }
    }


    public async Task ClearLog()
    {

        await _utilityService.ClearLog();

        await GetLog();
    }

}
