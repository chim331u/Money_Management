@page "/supplier"
<MM_WEB.Shared.Components.BreadCrumb path="supplier"></MM_WEB.Shared.Components.BreadCrumb>
@if (_accessService.IsAuthorized)
{
    @if (suppliers == null)
    {
        <p><em>Loading ...</em></p>
    }
    else
    {
        <RadzenMenu>
            <RadzenMenuItem Text="New" Icon="add" Click="@InsertRow" Disabled=@(supplierToInsert != null || supplierToUpdate != null)></RadzenMenuItem>
        </RadzenMenu>
        <br />
        <RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="true" @ref="supplierGrid"
                        FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="15" AllowPaging="true"
                        PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="false" ColumnWidth="250px"
                        Data="@suppliers" TItem="Supplier" LogicalFilterOperator="LogicalFilterOperator.Or"
                        EditMode="DataGridEditMode.Single" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow"
                        Sort="@Reset" Page="@Reset" Filter="@Reset" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        SelectionMode="DataGridSelectionMode.Single" @bind-Value=@selectedSupplier
                        RowClick="@((args) => OnRowClick(args))" Density="Density.Compact">

            <Columns>
                <RadzenDataGridColumn TItem="Supplier" Property="Id" Filterable="false" Title="ID"
                                      Frozen="true" Width="20px" TextAlign="TextAlign.Center" />

                <RadzenDataGridColumn TItem="Supplier" Property="Name" Title="Name" Frozen="true" Width="50px">
                    <EditTemplate Context="supplier">
                        <RadzenTextBox @bind-Value="supplier.Name" Style="width:100%; display: block" Name="Name" />
                        <RadzenRequiredValidator Text="Name is required" Component="Name" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Supplier" Property="Description" Title="Description" Frozen="true" Width="50px">
                    <EditTemplate Context="supplier">
                        <RadzenTextBox @bind-Value="supplier.Description" Style="width:100%; display: block" Name="Description" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Supplier" Property="Type" Title="Type" Frozen="true" Width="50px">
                    <EditTemplate Context="supplier">
                        <RadzenAutoComplete @bind-Value=@supplier.Type Data=@type
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            Name="Type" Style="width: 13rem" />
                        <RadzenRequiredValidator Text="Type is required" Component="Type" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Supplier" Property="UnitMeasure" Title="Unit of Measure" Frozen="true" Width="50px">
                    <EditTemplate Context="supplier">
                        <RadzenTextBox @bind-Value="supplier.UnitMeasure" Style="width:100%; display: block" Name="UnitMeasure" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Supplier" Property="Contract" Title="Contract" Frozen="true" Width="50px">
                    <EditTemplate Context="supplier">
                        <RadzenTextBox @bind-Value="supplier.Contract" Style="width:100%; display: block" Name="Contract" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Supplier" Property="Note" Title="Note" Frozen="true" Width="50px">
                    <EditTemplate Context="supplier">
                        <RadzenTextBox @bind-Value="supplier.Note" Style="width:100%; display: block" Name="Note" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Supplier" Context="supplier" Filterable="false" Sortable="false"
                                      TextAlign="TextAlign.Center" Width="10%">
                    <Template Context="supplier">

                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(args => EditRow(supplier))" @onclick:stopPropagation="true">
                        </RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Dark" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter"
                                      Size="ButtonSize.Small" class="my-1 ms-1" Click="@(args => DeleteRow(supplier))" @onclick:stopPropagation="true">
                        </RadzenButton>
                    </Template>
                    <EditTemplate Context="supplier">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                      Size="ButtonSize.Small" Click="@((args) => SaveRow(supplier))">
                        </RadzenButton>
                        <RadzenButton Icon="undo" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      class="my-1 ms-1" Click="@((args) => CancelEdit(supplier))">
                        </RadzenButton>

                    </EditTemplate>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>

        <hr />
        if (selectedSupplier != null)
        {
            <RadzenMenu>
                Supplier: @selectedSupplier[0].Name
                <RadzenMenuItem Text="New" Icon="add" Click="@InsertRowReadInBill"></RadzenMenuItem>
            </RadzenMenu>
            <br />

            <RadzenDataGrid AllowFiltering="false" AllowColumnResize="true" AllowAlternatingRows="true" @ref="readInBillGrid"
                            AllowSorting="true" PageSize="15" AllowPaging="true"
                            PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true" ColumnWidth="250px"
                            Data="@_readInBill" TItem="ReadInBill" LogicalFilterOperator="LogicalFilterOperator.Or"
                            EditMode="DataGridEditMode.Single" RowUpdate="@OnUpdateRowReadInBill" RowCreate="@OnCreateRowReadInBill"
                            Sort="@ResetReadInBill" Page="@ResetReadInBill" Filter="@ResetReadInBill"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Density="Density.Compact">

                <Columns>
                    <RadzenDataGridColumn TItem="ReadInBill" Property="Id" Filterable="false" Title="ID"
                                          Frozen="true" Width="20px" TextAlign="TextAlign.Center" />

                    <RadzenDataGridColumn TItem="ReadInBill" Property="BillProperty" Title="Property" Frozen="true" Width="50px">
                        <EditTemplate Context="readInBill">
                            <RadzenDropDown AllowClear="true" Name="readInBill.BillProperty"
                                            TValue="string" Class="w-99" Placeholder="Select a Property"
                                            AllowFiltering="true"  
                                            Data=@billProperties @bind-Value="readInBill.BillProperty" />
                            <RadzenRequiredValidator Text="Property is required" Component="readInBill.BillProperty" Popup="false" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="ReadInBill" Property="PropertyDataType" Title="Data Type" Frozen="true" Width="50px">
                        <EditTemplate Context="readInBill">
                            <RadzenDropDown AllowClear="true" Name="readInBill.PropertyDataType"
                                            TValue="string" Class="w-99" Placeholder="Select a DataType"
                                            AllowFiltering="true"
                                            Data=@billTypes @bind-Value="readInBill.PropertyDataType" />
                            <RadzenRequiredValidator Text="DataType is required" Component="readInBill.PropertyDataType" Popup="false" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="ReadInBill" Property="KeyWord" Title="KeyWord" Frozen="true" Width="50px">
                        <EditTemplate Context="readInBill">
                            <RadzenTextBox @bind-Value="readInBill.KeyWord" Style="width:100%; display: block" Name="KeyWord" />
                            <RadzenRequiredValidator Text="KeyWord is required" Component="KeyWord" Popup="false" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="ReadInBill" Property="RegexString" Title="RegexString" Frozen="true" Width="50px">
                        <EditTemplate Context="readInBill">
                            <RadzenTextBox @bind-Value="readInBill.RegexString" Style="width:100%; display: block" Name="RegexString" />
                            <RadzenRequiredValidator Text="RegexString is required" Component="RegexString" Popup="false" />
                        </EditTemplate>
                    </RadzenDataGridColumn>


                    <RadzenDataGridColumn TItem="ReadInBill" Property="Note" Title="Note" Frozen="true" Width="40px">
                        <EditTemplate Context="readInBill">
                            <RadzenTextBox @bind-Value="readInBill.Note" Style="width:100%; display: block" Name="Note" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="ReadInBill" Context="readInBill" Filterable="false" Sortable="false"
                                          TextAlign="TextAlign.Center" Width="10%">
                        <Template Context="readInBill">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                          Click="@(args => EditRowReadInBill(readInBill))" @onclick:stopPropagation="true">
                            </RadzenButton>
                            <RadzenButton Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" ButtonStyle="ButtonStyle.Dark"
                                          Size="ButtonSize.Small" class="my-1 ms-1" Click="@(args => DeleteRowReadInBill(readInBill))" @onclick:stopPropagation="true">
                            </RadzenButton>
                        </Template>
                        <EditTemplate Context="readInBill">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                          Size="ButtonSize.Small" Click="@((args) => SaveRowReadInBill(readInBill))">
                            </RadzenButton>
                            <RadzenButton Icon="undo" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                          class="my-1 ms-1" Click="@((args) => CancelEditReadInBill(readInBill))">
                            </RadzenButton>
                        </EditTemplate>
                    </RadzenDataGridColumn>

                </Columns>
            </RadzenDataGrid>

        }

    }
}
else
{
    <NotAuthorizePage></NotAuthorizePage>
}





@code {
    [Inject]
    public IAnchillaryService _service { get; set; }
    [Inject]
    public IAccessServices _accessService { get; set; }
    [Inject]
    public IUtilityServices _utilityService { get; set; }

    protected IList<Supplier>? suppliers;
    protected IList<string>? type;

    protected IList<ReadInBill>? readInBill;
    protected IList<ReadInBill>? _readInBill;
    protected IList<Supplier>? selectedSupplier;

    protected IList<string>? billProperties;
    protected IList<string>? billTypes;


    protected override async Task OnInitializedAsync()
    {

        if (_accessService.IsAuthorized)
        {
            await RefreshData();
            await RefreshReadInBill();
            if (suppliers != null)
            {
                type = suppliers.Select(x => x.Type).Distinct().ToList();

                billProperties = new List<string>();
                billProperties.Add("Amount");
                billProperties.Add("PaidDate");
                billProperties.Add("RefPeriodStart");
                billProperties.Add("RefPeriodEnd");
                billProperties.Add("Consumtion");
                billProperties.Add("BillNumber");

                billTypes = new List<string>();
                billTypes.Add("double");
                billTypes.Add("DateTime");
                billTypes.Add("string");


            }
        }
    }

    protected async Task RefreshReadInBill()
    {
        if (suppliers != null)
        {
            readInBill = await _service.GetActiveReadInBillList();
        }
        StateHasChanged();
    }

    protected async Task RefreshData()
    {
        suppliers = await _service.GetActiveSupplierList();
        StateHasChanged();

    }

    #region Supplier Grid
    Supplier? supplierToUpdate;
    Supplier? supplierToInsert;
    RadzenDataGrid<Supplier>? supplierGrid;

    protected void OnRowClick(DataGridRowMouseEventArgs<Supplier> args)
    {
        try
        {

            _readInBill = new List<ReadInBill>();
            _readInBill = readInBill.Where(x => x.Supplier.Id == args.Data.Id).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

    }

    async Task EditRow(Supplier item)
    {
        supplierToUpdate = item;

        await supplierGrid.EditRow(item);
    }

    async void OnUpdateRow(Supplier item)
    {
        Reset();

        var result = await _service.UpdateSupplier(item);

        if (result != null)
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Info,
                        Summary = "Supplier Update",
                        Detail = $"Supplier {result.Name} updated",
                        Duration = 4000

                    });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error Update",
                        Detail = $"Supplier NOT updated",
                        Duration = 4000

                    });
        }
    }

    async void OnCreateRow(Supplier item)
    {
        var result = await _service.AddSupplier(item);

        supplierToInsert = null;

        if (result != null)
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Info,
                        Summary = "New Supplier Created",
                        Detail = $"Supplier {result.Name} created",
                        Duration = 4000

                    });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error",
                        Detail = "Error adding New Supplier",
                        Duration = 4000

                    });
        }

        await RefreshData();
    }

    async Task SaveRow(Supplier item)
    {
        await supplierGrid.UpdateRow(item);
    }

    async void CancelEdit(Supplier item)
    {
        Reset();

        supplierGrid.CancelEditRow(item);

        var orginalItem = await _service.GetSupplier(item.Id);

        StateHasChanged();

    }

    protected async Task InsertRow()
    {
        supplierToInsert = new Supplier();

        await supplierGrid.InsertRow(supplierToInsert);

    }

    async Task DeleteRow(Supplier item)
    {

        //confirm delete
        var dialogResult = await DialogService.OpenAsync("Confirm Delete", ds =>
    @<RadzenStack Gap="1.5rem">
        <p>Do you want delete the supplier <b>@item.Name</b>?</p>
        <RadzenStack Gap="2rem" Class="rz-p-4 rz-p-md-12">
            <RadzenRow AlignItems="AlignItems.Center" Class="rz-mt-4">
                <RadzenButton Text="No" Click="() => ds.Close(false)" ButtonStyle="ButtonStyle.Light" />
                <RadzenButton Click="() => ds.Close(true)" Text="Yes" ButtonStyle="ButtonStyle.Secondary"></RadzenButton>
            </RadzenRow>
        </RadzenStack>
    </RadzenStack>
        );

        if (dialogResult != null && dialogResult)
        {

            if (item == supplierToInsert)
            {
                supplierToInsert = null;
            }

            if (item == supplierToUpdate)
            {
                supplierToUpdate = null;
            }

            var result = await _service.DeleteSupplier(item);


            if (result != null)
            {
                NotificationService.Notify(new NotificationMessage
                        {
                            Severity = NotificationSeverity.Info,
                            Summary = "Supplier Deleted",
                            Detail = $"Supplier {result.Name} deleted",
                            Duration = 4000

                        });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                        {
                            Severity = NotificationSeverity.Error,
                            Summary = "Error",
                            Detail = "Error deleting Supplier",
                            Duration = 4000

                        });
            }
            await supplierGrid.Reload();
            await RefreshData();
        }
    }

    void Reset()
    {
        if (supplierToInsert != null)
        {
            supplierToInsert = null;
        }

        supplierToUpdate = null;
    }
    #endregion

    #region ReadIn Bill Grid

    ReadInBill? readInBillToUpdate;
    ReadInBill? readInBillToInsert;
    RadzenDataGrid<ReadInBill>? readInBillGrid;

    async Task EditRowReadInBill(ReadInBill item)
    {
        readInBillToUpdate = item;

        await readInBillGrid.EditRow(item);
    }

    async void OnUpdateRowReadInBill(ReadInBill item)
    {
        ResetReadInBill();

        var result = await _service.UpdateReadInBill(item);

        if (result != null)
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Info,
                        Summary = "ReadInBill Update",
                        Detail = $"ReadInBill updated",
                        Duration = 4000

                    });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error Update",
                        Detail = $"ReadInBill NOT updated",
                        Duration = 4000

                    });
        }
    }

    async void OnCreateRowReadInBill(ReadInBill item)
    {
        var result = await _service.AddReadInBill(item);

        readInBillToInsert = null;

        if (result != null)
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Info,
                        Summary = "New ReadInBill Created",
                        Detail = $"ReadInBill created",
                        Duration = 4000

                    });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error",
                        Detail = "Error adding New ReadInBill",
                        Duration = 4000

                    });
        }

        // await RefreshData();
        await RefreshReadInBill();
    }

    async Task SaveRowReadInBill(ReadInBill item)
    {
        await readInBillGrid.UpdateRow(item);
    }

    async void CancelEditReadInBill(ReadInBill item)
    {
        ResetReadInBill();

        readInBillGrid.CancelEditRow(item);

        var orginalItem = await _service.GetReadInBill(item.Id);

        StateHasChanged();

    }

    protected async Task InsertRowReadInBill()
    {
        readInBillToInsert = new ReadInBill();
        readInBillToInsert.Supplier = selectedSupplier[0];
        await readInBillGrid.InsertRow(readInBillToInsert);

    }

    async Task DeleteRowReadInBill(ReadInBill item)
    {

        //confirm delete
        var dialogResult = await DialogService.OpenAsync("Confirm Delete", ds =>
    @<RadzenStack Gap="1.5rem">
        <p>Do you want delete the ReadInBill n <b>@item.Id</b>?</p>
        <RadzenStack Gap="2rem" Class="rz-p-4 rz-p-md-12">
            <RadzenRow AlignItems="AlignItems.Center" Class="rz-mt-4">
                <RadzenButton Text="No" Click="() => ds.Close(false)" ButtonStyle="ButtonStyle.Light" />
                <RadzenButton Click="() => ds.Close(true)" Text="Yes" ButtonStyle="ButtonStyle.Secondary"></RadzenButton>
            </RadzenRow>
        </RadzenStack>
    </RadzenStack>
    );

        if (dialogResult != null && dialogResult)
        {

            if (item == readInBillToInsert)
            {
                readInBillToInsert = null;
            }

            if (item == readInBillToUpdate)
            {
                readInBillToUpdate = null;
            }

            var result = await _service.DeleteReadInBill(item);


            if (result != null)
            {
                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Info,
                        Summary = "ReadInBill Deleted",
                        Detail = $"ReadInBill {result.Id} deleted",
                        Duration = 4000

                    });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error",
                        Detail = "Error deleting ReadInBill",
                        Duration = 4000

                    });
            }
            await readInBillGrid.Reload();
            // await RefreshData();
            await RefreshReadInBill();
        }
    }

    void ResetReadInBill()
    {
        if (readInBillToInsert != null)
        {
            readInBillToInsert = null;
        }

        readInBillToUpdate = null;
    }
    #endregion
    
    #region Tooltips


    #endregion

}
