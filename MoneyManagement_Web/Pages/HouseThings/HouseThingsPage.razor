@page "/housethingspage"
<MM_WEB.Shared.Components.BreadCrumb path="housethingspage"></MM_WEB.Shared.Components.BreadCrumb>
@if (_accessService.IsAuthorized)
{
    @if (houseThings == null)
    {
        <p><em>Loading ...</em></p>
    }
    else
    {
        <RadzenMenu>
            <RadzenMenuItem Text="New" Icon="add" Click="@InsertRow" Disabled=@(houseThingToInsert != null || thingToUpdate != null)></RadzenMenuItem>
        </RadzenMenu>
        <br />
        <RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="true" @ref="houseThingsGrid"
                        FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="15" AllowPaging="true"
                        PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
                        Data="@houseThings" TItem="HouseThings" LogicalFilterOperator="LogicalFilterOperator.Or"
                        EditMode="DataGridEditMode.Single" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow"
                        Sort="@Reset" Page="@Reset" Filter="@Reset" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        ExpandMode="DataGridExpandMode.Single" RowExpand="RowExpand" ShowExpandColumn=true Density="Density.Compact">
            <Template Context="item">
                <RadzenDataGrid AllowFiltering="true" AllowPaging="false" AllowSorting="true" Data="@historyHouseThings"
                                TItem="HouseThings">
                    <Columns>
                        <RadzenDataGridColumn TItem="HouseThings" Property="Name" Title="Name" />
                        <RadzenDataGridColumn TItem="HouseThings" Property="Description" Title="Description">
                            <Template Context="data">
                                <p style="white-space:pre-wrap">@data.Model</p>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="HouseThings" Property="ItemType" Title="Type" />
                        <RadzenDataGridColumn TItem="HouseThings" Property="Model" Title="Model">
                            <Template Context="data">
                                <p style="white-space:pre-wrap">@data.Model</p>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="HouseThings" Property="PurchaseDate" Title="Date" FormatString="{0:dd/MM/yyyy}" />
                        <RadzenDataGridColumn TItem="HouseThings" Property="Cost" Title="Cost" FormatString="{0:C0}" />
                    </Columns>
                </RadzenDataGrid>
            </Template>
            <Columns>

                <RadzenDataGridColumn TItem="HouseThings" Title="Name" Frozen="true" Width="40px">
                    <Template Context="data">
                        <p style="white-space:pre-wrap">@data.Name</p>
                    </Template>
                    <EditTemplate Context="thing">
                        <RadzenTextBox @bind-Value="thing.Name" Style="width:100%; display: block" Name="Name" />
                        <RadzenRequiredValidator Text="Name is required" Component="Name" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="HouseThings" Property="Room.Name" Title="Room" Frozen="true" Width="50px">
                    <EditTemplate Context="data">
                        <RadzenDropDown AllowClear="true" Name="Room.Name"
                                        TValue="HouseThingsRooms" Class="w-99" Placeholder="Select a Room"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        AllowFiltering="true" TextProperty="Name"
                                        Data=@rooms @bind-Value="data.Room" />
                        <RadzenRequiredValidator Text="Room is required" Component="Room.Name" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="HouseThings" Title="Description" Frozen="true" Width="50px">
                    <Template Context="data">
                        <p style="white-space:pre-wrap">@data.Description</p>
                    </Template>
                    <EditTemplate Context="room">
                        <RadzenTextBox @bind-Value="room.Description" Style="width:100%; display: block" Name="Description" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="HouseThings" Property="ItemType" Title="Type" Frozen="true" Width="50px">
                    <EditTemplate Context="thing">
                        <RadzenTextBox @bind-Value="thing.ItemType" Style="width:100%; display: block" Name="ItemType" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="HouseThings" Title="Model" Frozen="true" Width="50px">
                    <Template Context="data">
                        <p style="white-space:pre-wrap">@data.Model</p>
                    </Template>
                    <EditTemplate Context="thing">
                        <RadzenTextBox @bind-Value="thing.Model" Style="width:100%; display: block" Name="Model" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="HouseThings" Property="PurchaseDate" Title="Date" Frozen="true" Width="40px" FormatString="{0:dd/MM/yyyy}">
                    <EditTemplate Context="thing">
                        <RadzenDatePicker @bind-Value="thing.PurchaseDate" ShowTime="false" HourFormat="12"
                                          DateFormat="dd/MM/yyyy" Style="width:100%; display: block" Name="PurchaseDate" />
                        <RadzenRequiredValidator Text="Date is required" Component="PurchaseDate" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="HouseThings" Property="Cost" Title="Cost" Frozen="true" Width="40px" FormatString="{0:C0}">
                    <EditTemplate Context="thing">
                        <RadzenNumeric @bind-Value="thing.Cost" Style="width:100%; display: block" Name="Cost" />
                        <RadzenRequiredValidator Text="Cost is required" Component="Cost" Popup="false" />
                    </EditTemplate>
                </RadzenDataGridColumn>


                <RadzenDataGridColumn TItem="HouseThings" Title="Note" Frozen="true" Width="30px">
                    <Template Context="data">
                        <p style="white-space:pre-wrap">@data.Note</p>
                    </Template>
                    <EditTemplate Context="thing">
                        <RadzenTextBox @bind-Value="thing.Note" Style="width:100%; display: block" Name="thing" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="HouseThings" Context="thing" Filterable="false" Sortable="false"
                                      TextAlign="TextAlign.Right" Width="10%">
                    <Template Context="thing">
                        <RadzenButton Icon="recycling" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(args => Renew(thing))"
                        @onclick:stopPropagation="true">
                        </RadzenButton>
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(args => EditRow(thing))" @onclick:stopPropagation="true">
                        </RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter"
                                      Size="ButtonSize.Small" class="my-1 ms-1" Click="@(args => DeleteRow(thing))" @onclick:stopPropagation="true">
                        </RadzenButton>
                    </Template>
                    <EditTemplate Context="thing">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                      Size="ButtonSize.Small" Click="@((args) => SaveRow(thing))">
                        </RadzenButton>
                        <RadzenButton Icon="undo" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      class="my-1 ms-1" Click="@((args) => CancelEdit(thing))">
                        </RadzenButton>
                    </EditTemplate>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>
    }
}
else
{
    <NotAuthorizePage></NotAuthorizePage>
}


@code {

    [Inject]
    public IAccessServices _accessService { get; set; }
    [Inject]
    public IHouseThingsService _service { get; set; }

    protected IList<HouseThings>? houseThings;
    protected IList<HouseThings>? historyHouseThings;
    protected IList<HouseThingsRooms>? rooms;

    HouseThings? thingToUpdate;
    HouseThings? houseThingToInsert;
    RadzenDataGrid<HouseThings>? houseThingsGrid;

    bool isRenew = false;

    protected override async Task OnInitializedAsync()
    {
        if (_accessService.IsAuthorized)
        {
            await RefreshData();

        }
    }

    protected async Task RefreshData()
    {
        rooms = await _service.GetActiveHouseThingsRoomsList();
        houseThings = await _service.GetActiveHouseThingsList();
        StateHasChanged();

    }



    async Task EditRow(HouseThings item)
    {
        thingToUpdate = item;

        await houseThingsGrid.EditRow(item);
    }

    async void OnUpdateRow(HouseThings item)
    {
        Reset();

        var result = await _service.UpdateHouseThings(item);

        if (result != null)
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Thing Update",
                        Detail = $"Thing {result.Name} updated",
                        Duration = 4000

                    });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error Update",
                        Detail = $"Thing NOT updated",
                        Duration = 4000

                    });
        }
    }

    async void OnCreateRow(HouseThings item)
    {
        var result = await _service.RenewHouseThings(item);

        houseThingToInsert = null;

        if (result != null)
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "New Thing Created",
                        Detail = $"Thing {result.Name} created",
                        Duration = 4000

                    });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error",
                        Detail = "Error adding New Thing",
                        Duration = 4000

                    });
        }

        await RefreshData();
    }

    async Task SaveRow(HouseThings item)
    {
        if (isRenew)
        {
            var result = await _service.RenewHouseThings(item);

            if (result != null)
            {
                await RefreshData();
                await houseThingsGrid.Reload();
                NotificationService.Notify(new NotificationMessage
                        {
                            Severity = NotificationSeverity.Success,
                            Summary = "Renew",
                            Detail = $"Item Renewed",
                            Duration = 2000

                        });

            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                        {
                            Severity = NotificationSeverity.Error,
                            Summary = "Error Renew",
                            Detail = $"Error during the Renew: check the log",
                            Duration = 2000

                        });
            }

            isRenew = false;
        }
        else
        {
            await houseThingsGrid.UpdateRow(item);
        }

    }

    async void CancelEdit(HouseThings item)
    {
        Reset();

        houseThingsGrid.CancelEditRow(item);

        var orginalItem = await _service.GetHouseThingsRooms(item.Id);

        StateHasChanged();

    }

    protected async Task InsertRow()
    {
        houseThingToInsert = new HouseThings();
        houseThingToInsert.PurchaseDate = DateTime.Now;

        await houseThingsGrid.InsertRow(houseThingToInsert);

    }

    async Task DeleteRow(HouseThings item)
    {

        //confirm delete
        var dialogResult = await DialogService.OpenAsync("Confirm Delete", ds =>
    @<RadzenStack Gap="1.5rem">
        <p>Do you want delete the thing <b>@item.Name</b>?</p>
        <RadzenStack Gap="2rem" Class="rz-p-4 rz-p-md-12">
            <RadzenRow AlignItems="AlignItems.Center" Class="rz-mt-4">
                <RadzenButton Text="No" Click="() => ds.Close(false)" ButtonStyle="ButtonStyle.Light" />
                <RadzenButton Click="() => ds.Close(true)" Text="Yes" ButtonStyle="ButtonStyle.Secondary"></RadzenButton>
            </RadzenRow>
        </RadzenStack>
        </RadzenStack>
    );

        if (dialogResult != null && dialogResult)
        {

            if (item == houseThingToInsert)
            {
                houseThingToInsert = null;
            }

            if (item == thingToUpdate)
            {
                thingToUpdate = null;
            }

            var result = await _service.DeleteHouseThings(item);


            if (result != null)
            {
                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Thing Deleted",
                        Detail = $"Thing {result.Name} deleted",
                        Duration = 4000

                    });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error",
                        Detail = "Error deleting Thing",
                        Duration = 4000

                    });
            }
            await houseThingsGrid.Reload();
            await RefreshData();
        }
    }

    void Reset()
    {
        if (houseThingToInsert != null)
        {
            houseThingToInsert = null;
        }

        thingToUpdate = null;
    }

    async Task RowExpand(HouseThings item)
    {
        historyHouseThings = null;
        historyHouseThings = await _service.GetHistoryHouseThingsList(item.HistoryId);
        // args.Expandable = args..Data.ShipCountry == "France" || args.Data.ShipCountry == "Brazil";
        // houseThings = await _service.GetActiveHouseThingsListByRoom(item.Id);
    }

    private async Task Renew(HouseThings item)
    {
        isRenew = true;
        item.Cost = 0;
        item.PurchaseDate = DateTime.Now;
        thingToUpdate = item;

        await houseThingsGrid.EditRow(item);


    }

    #region Tooltips


    #endregion
}
