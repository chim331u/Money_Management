@page "/testlocalstorage"

@inject LocalStorageAccessor LocalStorageAccessor
@inject SessionStorageAccessor SessionStorageAccessor

<h3>Local Storage Test</h3>
<form>
    <label class="form-label">
        Key
        <input class="form-control" type="text" @bind-value="Key" />
    </label>
    <label class="form-label">
        Value
        <input class="form-control" type="text" @bind-value="Value" />
    </label>
    <button class="btn btn-primary" type="button" @onclick="SetValueAsync">Set Value</button>
    <button class="btn btn-primary" type="button" @onclick="SetLogAsync">WriteLogSample</button>
</form>
<div>Stored Value: @StoredValue</div>
<button class="btn btn-primary" type="button" @onclick="GetValueAsync">Get Value</button>
<button class="btn btn-primary" type="button" @onclick="RemoveAsync">Remove Value</button>
<button class="btn btn-primary" type="button" @onclick="ClearAllAsync">Clear All</button>

<h3>Session Storage Test</h3>
<form>
    <label class="form-label">
        Key
        <input class="form-control" type="text" @bind-value="Key" />
    </label>
    <label class="form-label">
        Value
        <input class="form-control" type="text" @bind-value="Value" />
    </label>
    <button class="btn btn-primary" type="button" @onclick="SetSessionValueAsync">Set Value</button>
    <button class="btn btn-primary" type="button" @onclick="SetSessionLogAsync">WriteLogSample</button>
</form>
<div>Stored Value: @StoredValue</div>
<button class="btn btn-primary" type="button" @onclick="GetSessionValueAsync">Get Value</button>
<button class="btn btn-primary" type="button" @onclick="RemoveSessionAsync">Remove Value</button>
<button class="btn btn-primary" type="button" @onclick="ClearAllSessionAsync">Clear All</button>

<h3>Log throw Utility</h3>

<button class="btn btn-primary" type="button" @onclick="SetUtilityLogAsync">WriteLog </button>
<button class="btn btn-primary" type="button" @onclick="GetSessionLogValueAsync">Get log</button>
<br />
<textarea>@LogText</textarea>
@code {
    public string Key { get; set; } = "";
    public string Value { get; set; } = "";
    public string StoredValue { get; set; } = "";
    public string LogText { get; set; }

    public async Task SetValueAsync()
    {
        await LocalStorageAccessor.SetValueAsync(Key, Value);
    }

    public async Task SetLogAsync()
    {
        await LocalStorageAccessor.SetValueAsync(DateTime.Now.ToString(), "Sample log");
    }

    public async Task GetValueAsync()
    {
        StoredValue = await LocalStorageAccessor.GetValueAsync<string>(Key);
        Console.WriteLine($"Key: {Key}, Value: {StoredValue}");
    }

    public async Task RemoveAsync()
    {
        await LocalStorageAccessor.RemoveAsync(Key);
    }

    public async Task ClearAllAsync()
    {
        await LocalStorageAccessor.Clear();
    }

    //session
    public async Task SetSessionValueAsync()
    {
        await SessionStorageAccessor.SetValueAsync(Key, Value);
    }

    public async Task SetSessionLogAsync()
    {
        await SessionStorageAccessor.SetValueAsync(DateTime.Now.ToString(), "Sample log");
    }

    public async Task GetSessionValueAsync()
    {
        StoredValue = await SessionStorageAccessor.GetValueAsync<string>(Key);

        Console.WriteLine($"Key: {Key}, Value: {StoredValue}");
    }

    public async Task RemoveSessionAsync()
    {
        await SessionStorageAccessor.RemoveAsync(Key);
    }

    public async Task ClearAllSessionAsync()
    {
        await SessionStorageAccessor.Clear();
    }

    //utility
    [Inject]
    public IUtilityServices _utilityService { get; set; }

    public async Task SetUtilityLogAsync()
    {
        await _utilityService.WriteLog("Sample log");
    }

    public async Task GetSessionLogValueAsync()
    {
       
        LogText = await _utilityService.GetLog();
        Console.WriteLine($"Key: {Key}, Value: {StoredValue}");
    }
}