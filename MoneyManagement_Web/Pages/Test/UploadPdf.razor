    private void HandleFileChange(InputFileChangeEventArgs e)
    {

        selectedFile = e.File;
    }

    private async Task UploadFile()
    {

        if (selectedFile != null)
        {
            try
            {
                var content = new MultipartFormDataContent();
                var fileContent = new StreamContent(selectedFile.OpenReadStream(maxFileSize));

                fileContent.Headers.ContentType =
    new MediaTypeHeaderValue(selectedFile.ContentType);

                content.Add(
        content: fileContent,
    name: "\"file\"", //same name in api ws
    fileName: selectedFile.Name);

                var response = await _testService.UploadFile(content);
                if (response != null)
                {
                    Console.WriteLine($"File {response} uploaded");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);

            }

        }
    }

    private async Task ShowPdf()
    {

        if (selectedFile != null)
        {
            // Read the file content
            using (var stream = selectedFile.OpenReadStream())
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                var pdfBytes = ms.ToArray();
                pdfBase64 = Convert.ToBase64String(pdfBytes);

                // await ShowInlineDialog();
            }
        }
    }

