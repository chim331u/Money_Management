@page "/uploadpdf"
@using System.Net.Http.Headers
@using System.Text
@using UglyToad.PdfPig
@using UglyToad.PdfPig.Content
@* @using PdfSharp.Pdf.Content
@using PdfSharp.Pdf.Content.Objects
@using PdfSharp.Pdf.IO
 *@

<h3>File Upload</h3>
<h2>Load a pdf file and disply it</h2>

<InputFile OnChange="HandleFileChange" />
<RadzenButton Click="UploadFile" Text="Upload" />
<RadzenButton Text="Show PDF" Click=@ShowPdf ButtonStyle="ButtonStyle.Primary" />
<RadzenButton Text="Read PDF" Click=@PdfToText ButtonStyle="ButtonStyle.Secondary" />

<!-- Display text file from pdf-->
@if (textContent!=null)
{
    <div>
        <h4>Testo Estratto:</h4>
        <textarea rows="10" style="width: 100%;">@textContent.ToString()</textarea>
    </div>
}

<!-- Display uploaded file detail -->
@if (selectedFile != null)
{
    <RadzenCard>
        <ul>
            <li>
                File Name: @selectedFile.Name
            </li>
            <li>
                File Size: @selectedFile.Size
            </li>
            <li>
                File Type: @selectedFile.ContentType
            </li>
        </ul>

    </RadzenCard>
}

<!-- Display uploaded file content -->
@if (!string.IsNullOrEmpty(pdfBase64))
{
    <RadzenHtml>
        <iframe style="width: 100%; height:700px" srcdoc="@($"<iframe style='width: 100%; height:700px' src='data:application/pdf;base64,{pdfBase64}'></iframe>")"></iframe>
    </RadzenHtml>
}

@code {
