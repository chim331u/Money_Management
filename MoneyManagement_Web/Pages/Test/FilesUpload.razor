@page "/filesupload"
@using System.IO
@using Microsoft.AspNetCore.Http;
@using Radzen.Blazor.Rendering;
@using Tewr.Blazor.FileReader;

@inject IFileReaderService fileReader;

<h1>Upload File</h1>

<div class="row">

    <div class="col-4">
        <div class="form-group">
            <input type="file" @ref="inputReference" @onchange="async () => await OpenFileAsync()" />
            <ul>
                <li>FileName: @fileName</li>
                <li>Size: @size </li>
                <li>Type: @type </li>
            </ul>
        </div>
        <button class="btn btn-block btn-success" @onclick="async ()=> await UploadFileAsync()">Upload File</button>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert">
                File has been uploaded
            </div>
        }

    </div>

    <div class="col-4">
        @if (imagePath != null)
        {
            <h4>imagePath</h4>
            <img style="width:150px" src="@imagePath" />
        }

    </div>
</div>
<hr />

<div class="row">
    <div class="container-fluid">
        <div class="row px-3">
            <div class="col-lg-6 offset-lg-3 p-3">
                <RadzenCard>
                    <MM_WEB.Shared.Components.FileUploadComponent fileUpload="inputReference" _file="_file" _fileInfo="_fileInfo" )></MM_WEB.Shared.Components.FileUploadComponent>
                @* Change=@(args => OnChange(args, "Manual Upload") *@
                                 </RadzenCard>
<br />
